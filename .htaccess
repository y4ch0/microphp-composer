Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(?:\.git|app|bin|bootstrap|config|database|public|src|storage|tests|vendor|var)(?:/|$) - [F,L]
    RewriteRule ^(?:\.env|\.gitignore|composer\.(?:json|lock)|MODERNIZATION\.md)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
